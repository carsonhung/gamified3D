{
  "name": "gamified3d-stage",
  "version": "0.1.0",
  "description": "Orthographic three.js stage for 2.5D game UI: isometric, dimetric and tilted camera presets, resize, pixel scaling and render-on-demand.",
  "license": "Apache-2.0",
  "author": "Carson Hung (https://github.com/carsonhung)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carsonhung/gamified3D.git",
    "directory": "packages/gamified3d-stage"
  },
  "keywords": ["three", "isometric", "2.5d", "game-ui", "orthographic"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "node ../../scripts/check-dist.mjs ."
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  }
}
